{
  "name": "so_plan",
  "version": "0.0.1",
  "private": true,
  "description": "Sales Order Planning",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "devDependencies": {
    "@sap-ux/eslint-plugin-fiori-tools": "^10.17.1",
    "@sap-ux/ui5-middleware-fe-mockserver": "^2.4.18",
    "@sap/ux-ui5-tooling": "^1.33.0",
    "@ui5/cli": "^4.0.48",
    "eslint": "^10.12.0",
    "rimraf": "^5.0.5",
    "ui5-task-flatten-library": "3.0.2"
  },
  "scripts": {
    "start": "fiori run --open \"test/flpSandbox.html?sap-client=100&sap-ui-xx-viewCache=false#rovensasoplan-tile\"",
    "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandbox.html?sap-client=100&sap-ui-xx-viewCache=false#rovensasoplan-tile\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "start-mock": "fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-client=100&sap-ui-xx-viewCache=false#rovensasoplan-tile\"",
    "deploy": "npm run build && fiori deploy --config ui5-deploy.yaml",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "fiori run --open \"index.html?sap-client=100&sap-ui-xx-viewCache=false\"",
    "start-variants-management": "fiori run --open \"preview.html?fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true&sap-ui-xx-condense-changes=true&sap-client=100#preview-app\"",
    "undeploy": "npm run build && fiori undeploy --config ui5-deploy.yaml",
    "deploy-test": "npm run build && fiori deploy --config ui5-deploy.yaml --testMode true",
    "lint": "eslint ./"
  },
  "sapux": true,
  "sapuxLayer": "CUSTOMER_BASE",
  "ui5": {
    "dependencies": [
      "ui5-task-flatten-library"
    ]
  }
}
